{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ROGUE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "dev-debug",
      "displayName": "Developer Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "dev-release",
      "displayName": "Developer Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci",
      "displayName": "Continuous Integration",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ROGUE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ci-sanitizers",
      "displayName": "Continuous Integration with ASan and UBSan",
      "inherits": "ci",
      "cacheVariables": {
        "ROGUE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "ci-clang-tidy",
      "displayName": "Continuous Integration with clang-tidy",
      "inherits": "ci",
      "cacheVariables": {
        "ROGUE_ENABLE_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers"
    },
    {
      "name": "ci-clang-tidy",
      "configurePreset": "ci-clang-tidy"
    }
  ],
  "testPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-clang-tidy",
      "configurePreset": "ci-clang-tidy",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
